<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration>
    <context>
        <name>SME Platform</name>
        <desc>Security scanning context for the SME Multi-Vendor Web Platform</desc>
        <inscope>true</inscope>
        <incregexes>http://localhost:5000.*</incregexes>
        <incregexes>http://localhost:8008.*</incregexes>
        <excregexes>.*\.png</excregexes>
        <excregexes>.*\.jpg</excregexes>
        <excregexes>.*\.jpeg</excregexes>
        <excregexes>.*\.gif</excregexes>
        <excregexes>.*\.glb</excregexes>
        <excregexes>.*\.obj</excregexes>
        <tech>
            <include>Db</include>
            <include>Db.PostgreSQL</include>
            <include>Language</include>
            <include>Language.JavaScript</include>
            <include>Language.Python</include>
            <include>WS</include>
            <exclude>Db.CouchDB</exclude>
            <exclude>Db.Firebird</exclude>
            <exclude>Db.HSQLDB</exclude>
            <exclude>Db.IBM DB2</exclude>
            <exclude>Db.Microsoft Access</exclude>
            <exclude>Db.Microsoft SQL Server</exclude>
            <exclude>Db.MongoDB</exclude>
            <exclude>Db.MySQL</exclude>
            <exclude>Db.Oracle</exclude>
            <exclude>Db.SAP MaxDB</exclude>
            <exclude>Db.SQLite</exclude>
            <exclude>Db.Sybase</exclude>
            <exclude>Language.ASP</exclude>
            <exclude>Language.C</exclude>
            <exclude>Language.PHP</exclude>
            <exclude>OS</exclude>
            <exclude>OS.Linux</exclude>
            <exclude>OS.MacOS</exclude>
            <exclude>OS.Windows</exclude>
        </tech>
        <urlmanager/>
        <postprocessors/>
        <authentication>
            <type>5</type>
            <loggedout>\Q{"success":false\E</loggedout>
            <loggedin>\Q"success":true\E</loggedin>
        </authentication>
        <users/>
        <forceduser>-1</forceduser>
        <session>
            <type>0</type>
        </session>
        <authorization>
            <type>0</type>
            <basic>
                <header/>
                <body/>
                <status>-1</status>
            </basic>
        </authorization>
    </context>
</configuration>
