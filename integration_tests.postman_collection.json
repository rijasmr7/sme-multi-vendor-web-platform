      "name": "1. Vendor Workflows",
      "item": [
        {
          "name": "1.1 Register Vendor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomSuffix = Math.floor(Math.random() * 1000000);",
                  "pm.collectionVariables.set(\"vendor_email\", \"vendor_\" + randomSuffix + \"@sme.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Vendor ID returned\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    var vendorId = jsonData.data.id || jsonData.data._id;",
                  "    pm.expect(vendorId).to.not.be.undefined;",
                  "    pm.collectionVariables.set(\"vendor_id\", vendorId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vendor_email}}\",\n  \"password\": \"Password123\",\n  \"name\": \"Organic Garden Shop\",\n  \"role\": \"vendor\"\n}"
